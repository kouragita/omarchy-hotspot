#!/bin/sh
# One line per associated client, for the hotspot panel.
# Output:  <mac> <ip-or-dash> <signal dBm> <rx bytes> <tx bytes>
#
# Unprivileged: sysfs/iw/netlink data readable by the desktop user, so the
# panel never needs pkexec just to draw numbers.
set -u

AP="${1:-ap0}"

iw dev "$AP" station dump 2>/dev/null | awk '
  /^Station/    { mac = $2; sig = "-"; rx = 0; tx = 0 }
  /signal:/     { sig = $2 }
  /rx bytes:/   { rx = $3 }
  /tx bytes:/   { tx = $3 }
  /^[[:space:]]*$/ { if (mac != "") { print mac, sig, rx, tx; mac = "" } }
  END           { if (mac != "") print mac, sig, rx, tx }
' | while read -r mac sig rx tx; do
  ip=$(ip neigh show dev "$AP" 2>/dev/null | awk -v m="$mac" '$3 == m { print $1; exit }')
  printf '%s %s %s %s %s\n' "$mac" "${ip:--}" "$sig" "$rx" "$tx"
done
